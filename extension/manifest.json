{
  "manifest_version": 3,
  "name": "fivesight for Meet",
  "version": "0.3.1",
  "description": "Tells the fivesight app on your PC who is speaking in Google Meet. Sends names and timings to 127.0.0.1 only.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47285/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/tracker.js", "src/selectors.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/32.png", "32": "icons/32.png", "48": "icons/64.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "fivesight",
    "default_icon": { "16": "icons/32.png", "32": "icons/32.png" }
  }
}
