{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fivesight",
  "version": "0.1.0",
  "identifier": "dev.fivesight.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fivesight",
        "width": 1080,
        "height": 720,
        "minWidth": 780,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
